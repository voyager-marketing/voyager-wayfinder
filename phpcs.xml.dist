<?xml version="1.0"?>
<ruleset name="Voyager Wayfinder">
    <description>
        PSR-12 for style, WordPress sniffs for the things that bite: unescaped
        output, unsanitized input, raw SQL, missing nonces, untranslated
        strings. Mirrors voyager-orbit phpcs.xml @ abe7d26, which explains why
        the full WordPress ruleset is not used on PSR-12 code.
    </description>

    <file>src</file>
    <file>tests</file>
    <file>voyager-wayfinder.php</file>
    <file>uninstall.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <rule ref="WordPress.Security.EscapeOutput"/>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
    <rule ref="WordPress.WP.I18n"/>

    <config name="minimum_wp_version" value="6.9"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="voyager-wayfinder"/>
            </property>
        </properties>
    </rule>

    <!-- Unit tests are pure PHP with stubbed WordPress functions. -->
    <rule ref="WordPress.Security">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Manifest, scanner, notes and renderer exceptions never reach HTML
         themselves: they end at WP-CLI, in a REST error's JSON, or at a
         caller that escapes them when it renders. Orbit marks the same case
         line by line ("message never reaches HTML"). -->
    <rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
        <exclude-pattern>src/Manifest/*</exclude-pattern>
        <exclude-pattern>src/Notes/*</exclude-pattern>
        <exclude-pattern>src/Render/Ai/*</exclude-pattern>
        <exclude-pattern>src/Scanners/*</exclude-pattern>
    </rule>
</ruleset>
